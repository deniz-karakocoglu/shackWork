// shackWork — kişisel antrenman, beslenme ve gelişim takibi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GoalFocus {
  WEIGHT_LOSS
  MUSCLE
  PERFORMANCE
  GENERAL
}

enum UserRole {
  USER
  COACH
}

model User {
  id           String     @id @default(cuid())
  name         String?
  surname      String?
  birthDate    DateTime?
  email        String     @unique
  passwordHash String
  role         UserRole   @default(USER)
  heightCm     Float?
  goalFocus    GoalFocus  @default(GENERAL)
  coachId      String?
  coach        Coach?     @relation(fields: [coachId], references: [id])
  createdAt    DateTime   @default(now())

  metrics BodyMetric[]
  goals   Goal[]
  dayLogs DayLog[]
  photos  ProgressPhoto[]
  plans   WeeklyPlan[]
  coachNotesReceived CoachNote[] @relation("CoachNoteClient")
  coachNotesAuthored CoachNote[] @relation("CoachNoteAuthor")
  resetTokens PasswordResetToken[]
}

model Coach {
  id            String  @id @default(cuid())
  name          String
  title         String?
  bio           String
  specialties   String
  avatarEmoji   String?
  // Profil fotografi (or. /coaches/isim.jpg). Bos ise avatarEmoji kullanilir.
  photoUrl      String?
  users         User[]
}

model BodyMetric {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt     DateTime
  weightKg       Float
  bodyFatPercent Float?
}

model Goal {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  startDate      DateTime @default(now())
  targetDate     DateTime
  durationMonths Int?
}

model DayLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logDate      String
  trainingText String?
  mealsText    String?
  notes        String?
  aiReport     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, logDate])
}

model ProgressPhoto {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt  DateTime
  imageUrl String
  note     String?
}

model WeeklyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   String
  weekEnd     String
  focus       GoalFocus
  workoutPlan String
  mealPlan    String
  createdAt   DateTime @default(now())

  @@unique([userId, weekStart])
}

model CoachNote {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  client User @relation("CoachNoteClient", fields: [clientId], references: [id], onDelete: Cascade)
  author User @relation("CoachNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
