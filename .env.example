# shackWork — örnek ortam değişkenleri
# Kullanım: bu dosyayı kopyalayıp `.env` yapın ve değerleri doldurun.

DATABASE_URL="file:./prisma/dev.db"

# Oturum JWT (üretimde mutlaka güçlü ve gizli tutun)
JWT_SECRET=buraya-uzun-rastgele-bir-dize

# Google Gemini — haftalık plan (hedeflere göre) + günlük rapor AI
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı model (boşsa sunucu birkaç model dener)
# GEMINI_MODEL=gemini-2.0-flash
